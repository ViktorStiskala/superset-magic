#!/usr/bin/env bash
#
# The bridge between a skill body and the pinned binary.
#
# A skill body runs through the Bash tool. ${CLAUDE_PLUGIN_DATA} - the directory
# the SessionStart bootstrap installs into - is exported to hook and MCP/LSP
# processes only, and is NOT in the Bash tool's environment, so a skill cannot
# name that path: it would expand to nothing and produce a path at the
# filesystem root, with no error. The plugin's own bin/ directory IS on the Bash
# tool's PATH while the plugin is enabled, so this wrapper is what every skill
# invokes.
#
# Two things about it are load-bearing:
#
#   * The name is `ss-magic-plugin`, not `ss-magic`. A wrapper called `ss-magic`
#     would collide on PATH with a user's own installed ss-magic, and the
#     resolution order between the plugin's bin/ and that install is not
#     something this plugin controls. Non-deterministic resolution is exactly
#     what pinning a version exists to prevent, so the wrapper takes a name
#     nothing else claims.
#   * It injects the `plugin` verb, so a skill reads `ss-magic-plugin checklist
#     list` rather than stuttering, and consequently cannot reach bare
#     `ss-magic` at all - no update gate, no TUI. That posture is enforced by
#     shape here rather than by care at every call site.
#
# A missing binary is a normal, expected state, not an error: the first session
# after an install or a pin bump runs with the binary still arriving, because
# hooks on one event fire concurrently and the bootstrap cannot be relied on to
# finish before a skill runs. So this exits 0 with one line of explanation
# rather than failing the skill mid-run.
#
# "Exits 0" holds on every path. "One line" holds on every path a real install
# can reach - absent binary, a directory in its place, a damaged binary, a
# missing handoff. The one exception is an interpreted wrapper whose shebang
# names a missing interpreter: bash prints its own diagnostic before `execfail`
# returns control, so that case yields bash's lines plus ours. It is not
# reachable with the released binary, which is a compiled executable, and the
# alternative - redirecting the exec's stderr - would swallow the real binary's
# diagnostics on the success path.

set -u

explain() {
    printf 'ss-magic: %s\n' "$1" >&2
    exit 0
}

self_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd) ||
    explain "cannot locate the plugin directory; no ss-magic command was run."

# $BIN is resolved through a durable, Bash-visible handoff rather than an
# environment variable, because no variable naming the data directory reaches
# this process. The bootstrap writes the resolved data directory into
# <R80 root>/data-root, and both sides recompute that R80 root from $HOME - the
# one input a hook process and a Bash-tool process are guaranteed to share.
# lib/tmproot.sh is the single implementation of that path, sourced by both, so
# the writer and the reader cannot drift apart.
lib="$self_dir/../lib/tmproot.sh"
[ -r "$lib" ] || explain "the plugin tree is incomplete ($lib is missing); no ss-magic command was run."
# shellcheck source=../lib/tmproot.sh
. "$lib" || explain "the plugin tree is unreadable; no ss-magic command was run."

# The variable is preferred when it happens to be set - a hook or MCP process
# invoking this wrapper already has the authoritative value and need not go
# through the handoff at all.
data=${CLAUDE_PLUGIN_DATA:-}
if [ -z "$data" ]; then
    # Read-only: this is a pure consumer of a file the bootstrap wrote. It never
    # creates the root, because a root it had to create would by definition hold
    # no handoff to read.
    root=$(ss_magic_resolve_root) ||
        explain "the plugin has not run its session-start bootstrap yet; no ss-magic command was run."
    handoff="$root/$SS_MAGIC_DATA_ROOT_FILE"
    [ -r "$handoff" ] ||
        explain "the pinned binary has not been installed yet; start a new session to install it."
    # Braced so the suppression covers the redirection itself, not just the
    # builtin - see hooks/run-hook.sh and bootstrap.sh's `write_line`.
    { IFS= read -r data <"$handoff"; } 2>/dev/null
    [ -n "${data:-}" ] ||
        explain "the pinned binary has not been installed yet; start a new session to install it."
fi

bin="$data/bin/ss-magic"
# `lib/execguard.sh`, not a bare `[ -x ]`. `-x` is true for a DIRECTORY carrying
# the search bit, and it cannot see execve failing on the way in, so either shape
# would reach `exec` and end in bash's own diagnostic plus a 126 - breaking this
# script's promise to exit 0 with one line of explanation rather than failing the
# skill mid-run. The guard is shared with hooks/run-hook.sh precisely so the two
# cannot drift apart again.
guard="$self_dir/../lib/execguard.sh"
[ -r "$guard" ] || explain "the plugin tree is incomplete ($guard is missing); no ss-magic command was run."
# shellcheck source=../lib/execguard.sh
. "$guard" || explain "the plugin tree is unreadable; no ss-magic command was run."

ss_magic_is_loadable_executable "$bin" ||
    explain "the pinned binary at $bin is missing or not runnable; start a new session to install it."

# `execfail` covers the exec failures the guard cannot see from the file alone
# (a missing shebang interpreter, a noexec mount), so control returns here and
# reaches the explanatory exit instead of bash exiting 126 with its own message.
shopt -s execfail
exec "$bin" plugin "$@"
explain "the pinned binary at $bin could not be executed; start a new session to reinstall it."
